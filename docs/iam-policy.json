{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AdaptiveVisibilityTestQueueOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:REGION:ACCOUNT_ID:adaptive-visibility-test"
    }
  ]
}

